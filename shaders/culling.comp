#version 450

layout(local_size_x = 64) in;

struct ObjectData
{
    vec4 boundingSphere;  // xyz=center, w=radius
};

struct InstanceData
{
    vec4 position;
};

// 输入：原始物体数据（343个）
layout(std430, binding = 0) readonly buffer ObjectBuffer
{
    ObjectData objects[];
};

// 输出：压缩后的instance数据（只有通过culling的会被写入）
layout(std430, binding = 1) writeonly buffer VisibleInstanceBuffer
{
    InstanceData visibleInstances[];
};

// 输出：Indirect Draw参数（GPU自己改写instanceCount）
layout(std430, binding = 3) buffer IndirectDrawBuffer
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
} indirectDraw;

layout(binding = 2) uniform FrustumData
{
    vec4 planes[6];
} frustum;

void main()
{
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= objects.length()) return;

    vec3 center = objects[idx].boundingSphere.xyz;
    float radius = objects[idx].boundingSphere.w;

    bool inside = true;
    for (int i = 0; i < 6; i++)
    {
        float dist = dot(frustum.planes[i].xyz, center) + frustum.planes[i].w;
        if (dist < -radius)
        {
            inside = false;
            break;
        }
    }

    if (inside)
    {
        // 原子递增计数器，拿到自己应该写入的位置
        uint writeIndex = atomicAdd(indirectDraw.instanceCount, 1u);
        visibleInstances[writeIndex].position = vec4(center, 1.0);
    }
}


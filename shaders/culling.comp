#version 450

layout(local_size_x = 64) in;

struct ObjectData
{
    vec4 boundingSphere;  // xyz=center, w=radius
};

struct InstanceData
{
    vec4 position;
};

struct DrawCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, binding = 0) readonly buffer ObjectBuffer
{
    ObjectData objects[];
};

// 3 individual visible instance buffer
layout(std430, binding = 1) writeonly buffer VisibleLOD0
{
    InstanceData visibleLOD0[];
};

layout(std430, binding = 2) writeonly buffer VisibleLOD1
{
    InstanceData visibleLOD1[];
};

layout(std430, binding = 3) writeonly buffer VisibleLOD2
{
    InstanceData visibleLOD2[];
};

// 3 individual indirect draw buffer
layout(std430, binding = 4) buffer IndirectLOD0 { DrawCommand cmd0; };
layout(std430, binding = 5) buffer IndirectLOD1 { DrawCommand cmd1; };
layout(std430, binding = 6) buffer IndirectLOD2 { DrawCommand cmd2; };

layout(binding = 7) uniform FrustumData
{
    vec4 planes[6];
    vec4 cameraPos;      // xyz=camera pos, w not yet
    vec4 lodDistances;   // x = LOD1_DIST, y = LOD2_DIST, zw unused -
                          // runtime-tunable, see VulkanContext::lod1Distance()
} frustum;

// Shadow pass's light-frustum-culled instance set - same objects[], own
// independent 6-plane test (the light's orthographic frustum, not the
// camera's perspective one), always LOD0 geometry (the shadow pass never
// LOD-selects). See ShadowPass in FrameRenderer.cpp.
layout(std430, binding = 8) writeonly buffer ShadowVisible
{
    InstanceData shadowVisible[];
};
layout(std430, binding = 9) buffer ShadowIndirect { DrawCommand shadowCmd; };

layout(binding = 10) uniform LightFrustumData
{
    vec4 planes[6];
} lightFrustum;

// Coarse pass's per-cluster visibility flags (cullingCoarse.comp writes
// these, run first in GPUCullingPass with a compute->compute barrier
// before this shader's dispatch - see FrameRenderer.cpp). Gating the
// per-object tests below behind these flags never changes the final
// visible set: each cluster's bounding sphere strictly contains every
// member's sphere, so a cluster failing a plane test implies every member
// would too (docs/TECHNICAL_NOTES.md has the full proof). This shader
// only needs the flags, not the cluster bounding spheres themselves.
layout(std430, binding = 12) readonly buffer ClusterVisibleCamera
{
    uint clusterVisibleCamera[];
};
layout(std430, binding = 13) readonly buffer ClusterVisibleLight
{
    uint clusterVisibleLight[];
};

bool sphereInsideFrustum(vec3 center, float radius, vec4 planes[6])
{
    for (int i = 0; i < 6; i++)
    {
        float dist = dot(planes[i].xyz, center) + planes[i].w;
        if (dist < -radius)
            return false;
    }
    return true;
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= objects.length()) return;

    // Recover this object's cluster index from its linear grid index -
    // must exactly match VulkanContext::clusterIndexForInstance() and the
    // nested x/y/z generation loop in initSceneData() (idx = x*49+y*7+z).
    // GRID_SIZE/CLUSTER_DIM/CLUSTERS_PER_AXIS are kept manually in sync
    // with VulkanContext's constants of the same name - no shared
    // C++/GLSL header exists in this codebase, same discipline already
    // used for every other shader constant (LOD distances, push-constant
    // struct sizes, etc).
    const uint GRID_SIZE = 7u;
    const uint CLUSTER_DIM = 2u;
    const uint CLUSTERS_PER_AXIS = 4u;   // ceil(GRID_SIZE / CLUSTER_DIM)

    uint gx = idx / (GRID_SIZE * GRID_SIZE);
    uint gy = (idx / GRID_SIZE) % GRID_SIZE;
    uint gz = idx % GRID_SIZE;
    uint clusterIdx = (gx / CLUSTER_DIM) * (CLUSTERS_PER_AXIS * CLUSTERS_PER_AXIS)
                    + (gy / CLUSTER_DIM) * CLUSTERS_PER_AXIS
                    + (gz / CLUSTER_DIM);

    bool clusterCamOk   = clusterVisibleCamera[clusterIdx] != 0u;
    bool clusterLightOk = clusterVisibleLight[clusterIdx]  != 0u;

    vec3 center = objects[idx].boundingSphere.xyz;
    float radius = objects[idx].boundingSphere.w;

    // Light-frustum test, independent of camera visibility below - the
    // shadow map must include everything that can cast a visible shadow,
    // regardless of whether the caster itself is on-screen. Skipped
    // entirely if the whole cluster already failed the coarse light test.
    if (clusterLightOk && sphereInsideFrustum(center, radius, lightFrustum.planes))
    {
        uint shadowSlot = atomicAdd(shadowCmd.instanceCount, 1u);
        shadowVisible[shadowSlot].position = vec4(center, 1.0);
    }

    // Camera frustum culling - independent of the light-frustum block
    // above (an object can be light-visible but camera-invisible or vice
    // versa), so this early return only affects the camera/LOD path below.
    if (!clusterCamOk)
        return;
    if (!sphereInsideFrustum(center, radius, frustum.planes))
        return;

    // distance influence LOD
    float camDist = length(center - frustum.cameraPos.xyz);

    if (camDist < frustum.lodDistances.x)
    {
        uint slot = atomicAdd(cmd0.instanceCount, 1u);
        visibleLOD0[slot].position = vec4(center, 1.0);
    }
    else if (camDist < frustum.lodDistances.y)
    {
        uint slot = atomicAdd(cmd1.instanceCount, 1u);
        visibleLOD1[slot].position = vec4(center, 1.0);
    }
    else
    {
        uint slot = atomicAdd(cmd2.instanceCount, 1u);
        visibleLOD2[slot].position = vec4(center, 1.0);
    }
}


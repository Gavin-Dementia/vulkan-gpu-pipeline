#version 450

// Sorts each LOD bucket's compacted visible-instance list back-to-front
// by camera distance, so an alpha-blended draw of that bucket composites
// correctly instead of in whatever order culling.comp's atomicAdd
// compaction happened to produce (see docs/TECHNICAL_NOTES.md §43).
// Dispatched (6,1,1) - one workgroup per bucket, selected by
// gl_WorkGroupID.x: 0-2 = normal LOD0-2, 3-5 = special LOD0-2 (Phase 23
// M2). No effect on opaque rendering (draw order doesn't matter when
// depth test alone resolves occlusion) - only meaningful for whichever
// bucket set is currently bound to the alpha-blend pipeline.
//
// 512 must stay >= VulkanContext::OBJECT_COUNT (343) - the same manual
// C++/GLSL sync discipline culling.comp's GRID_SIZE/CLUSTER_DIM already
// requires, no shared header exists in this codebase.
layout(local_size_x = 512) in;

struct InstanceData
{
    vec4 position;   // xyz = world position, w = camera distance (culling.comp)
};

struct DrawCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

// Read-write here (unlike culling.comp's writeonly) - this pass loads
// the compacted entries, sorts them in shared memory, then writes the
// sorted order back to the same buffer.
layout(std430, binding = 1) buffer VisibleLOD0 { InstanceData visibleLOD0[]; };
layout(std430, binding = 2) buffer VisibleLOD1 { InstanceData visibleLOD1[]; };
layout(std430, binding = 3) buffer VisibleLOD2 { InstanceData visibleLOD2[]; };

// Only instanceCount is read - already written by this frame's fine
// culling dispatch, guarded by the compute->compute barrier in
// FrameRenderer.cpp's GPUCullingPass, same shape as the coarse->fine one.
layout(std430, binding = 4) readonly buffer IndirectLOD0 { DrawCommand cmd0; };
layout(std430, binding = 5) readonly buffer IndirectLOD1 { DrawCommand cmd1; };
layout(std430, binding = 6) readonly buffer IndirectLOD2 { DrawCommand cmd2; };

// Phase 23 M2 (docs/roadmap.md) - "special"-material sibling buckets,
// same shapes as above. Dispatched unconditionally alongside buckets 0-2
// whenever any sorting happens at all (FrameRenderer.cpp) rather than
// gated on mixed materials specifically - sorting an empty or opaque
// bucket is a harmless near-no-op (tid < count is false for every thread
// when count is 0), cheaper to always include than to plumb a second
// conditional dispatch.
layout(std430, binding = 14) buffer VisibleLOD0Special { InstanceData visibleLOD0Special[]; };
layout(std430, binding = 15) buffer VisibleLOD1Special { InstanceData visibleLOD1Special[]; };
layout(std430, binding = 16) buffer VisibleLOD2Special { InstanceData visibleLOD2Special[]; };
layout(std430, binding = 17) readonly buffer IndirectLOD0Special { DrawCommand cmd0Special; };
layout(std430, binding = 18) readonly buffer IndirectLOD1Special { DrawCommand cmd1Special; };
layout(std430, binding = 19) readonly buffer IndirectLOD2Special { DrawCommand cmd2Special; };

const uint N = 512u;
shared InstanceData sharedData[N];

void main()
{
    uint tid    = gl_LocalInvocationID.x;
    uint bucket = gl_WorkGroupID.x;   // 0-2 = normal LOD0-2, 3-5 = special LOD0-2

    uint count;
    if (bucket == 0u)      count = cmd0.instanceCount;
    else if (bucket == 1u) count = cmd1.instanceCount;
    else if (bucket == 2u) count = cmd2.instanceCount;
    else if (bucket == 3u) count = cmd0Special.instanceCount;
    else if (bucket == 4u) count = cmd1Special.instanceCount;
    else                   count = cmd2Special.instanceCount;

    // Load into shared memory. Padding slots (tid >= count) get a
    // distance of -1.0 - camera distance is never negative, so these
    // always sort to the tail past index [count), which the indirect
    // draw's instanceCount never reads anyway.
    InstanceData entry;
    if (tid < count)
    {
        if (bucket == 0u)      entry = visibleLOD0[tid];
        else if (bucket == 1u) entry = visibleLOD1[tid];
        else if (bucket == 2u) entry = visibleLOD2[tid];
        else if (bucket == 3u) entry = visibleLOD0Special[tid];
        else if (bucket == 4u) entry = visibleLOD1Special[tid];
        else                   entry = visibleLOD2Special[tid];
    }
    else
    {
        entry.position = vec4(0.0, 0.0, 0.0, -1.0);
    }
    sharedData[tid] = entry;
    barrier();
    memoryBarrierShared();

    // Parallel odd-even transposition sort, descending by position.w
    // (camera distance) - farthest first, so index 0 is drawn first and
    // the nearest instance last, the correct order for back-to-front
    // alpha blending. N phases guarantee a full sort of N elements (the
    // worst-case distance any single element must travel across the
    // array); each phase only needs N/2 threads, since it compares N/2
    // disjoint adjacent pairs, alternating which pairs those are between
    // even and odd phases - the standard construction, chosen over a
    // bitonic network for this project's "simplest correct
    // implementation" bar: no power-of-2 partner-index bit math, no
    // sentinel-value edge cases beyond the one already needed for
    // padding above. At n<=343 the O(n^2) phase count costs
    // microseconds regardless on a GPU, so there's no real performance
    // reason to prefer bitonic's O(n log^2 n) here.
    for (uint phase = 0u; phase < N; phase++)
    {
        uint i = 2u * tid + (phase & 1u);
        if (tid < (N / 2u) && i + 1u < N)
        {
            if (sharedData[i].position.w < sharedData[i + 1u].position.w)
            {
                InstanceData tmp   = sharedData[i];
                sharedData[i]      = sharedData[i + 1u];
                sharedData[i + 1u] = tmp;
            }
        }
        barrier();
        memoryBarrierShared();
    }

    // Write back only the real entries - padding slots are now at the
    // tail (w = -1.0) and never need writing back.
    if (tid < count)
    {
        if (bucket == 0u)      visibleLOD0[tid] = sharedData[tid];
        else if (bucket == 1u) visibleLOD1[tid] = sharedData[tid];
        else if (bucket == 2u) visibleLOD2[tid] = sharedData[tid];
        else if (bucket == 3u) visibleLOD0Special[tid] = sharedData[tid];
        else if (bucket == 4u) visibleLOD1Special[tid] = sharedData[tid];
        else                   visibleLOD2Special[tid] = sharedData[tid];
    }
}
